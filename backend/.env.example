# Variables del orquestador (contact-update-orchestrator). Copiar a .env (no se versiona).
# Lección de INC-004: toda variable nueva se agrega aquí, en application.yml, en
# ContactUpdateProperties (validada) y en el README.
# Sin las OBLIGATORIAS (fuera del perfil sim) el servicio NO arranca y el error nombra la que falta.

# --- Obligatorias fuera del perfil sim ---
# Orígenes del portal, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Customer Data, Identity Capability y Messaging vía IntegrationHub
PROVIDER_CUSTOMER_DATA_URL=sim://customer-data
PROVIDER_IDENTITY_URL=sim://identity
PROVIDER_MESSAGING_URL=sim://messaging

# --- Opcionales (estos son los valores por defecto) ---
SERVER_PORT=8080
# Vigencia del OTP (INC-003), intentos, espera y reenvíos
OTP_TTL=PT5M
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=PT30S
OTP_MAX_RESENDS=3
# Vida del flujo en el servidor
FLOW_TTL=PT10M
# Rate limiting por ventana
RATE_LIMIT_MAX_FLOWS_PER_DOCUMENT=5
RATE_LIMIT_MAX_FLOWS_PER_IP=30
RATE_LIMIT_WINDOW=PT15M
# Timeouts de proveedores (INC-002)
PROVIDER_TIMEOUT=PT3S
PROVIDER_MESSAGING_TIMEOUT=PT2S

# --- Solo perfil sim (PROHIBIDAS en producción) ---
SIM_FIXED_OTP=123456
SIM_SLOW_CALL_DELAY=PT4S
